# ==========================================================================
# .env.example - Plantilla pública de variables de entorno (SÍ se sube a Git)
# Copiala como .env (copy .env.example .env) y completá tus datos.
# El .env real NO se sube: está en .gitignore.
# ==========================================================================

# Puerto del servidor Express
PORT=3000

# Clave para firmar los tokens de sesión (inventá un texto largo)
JWT_SECRET=cambiame-por-un-texto-largo-y-secreto

# MySQL en Aiven (Overview → Connection information)
DB_HOST=mysql-biblioteca-eest5-xxxx.aivencloud.com
DB_PORT=27892
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb

# SSL: Aiven lo exige. Guardá el ca.pem de Aiven dentro de backend/
DB_SSL=true
DB_CA_PATH=ca.pem

# Opcionales
# DB_ZONA_HORARIA=-03:00
# DIAS_PRESTAMO=7
