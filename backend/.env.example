# =========================================================
#  Copiar este archivo como ".env" (en esta misma carpeta
#  backend/) y completar los datos. Lo leen Node y PHP.
#  El .env NO se sube a GitHub (está en .gitignore).
# =========================================================

# --- Servidor Node (Express) ---
PORT=3000

# --- Base de datos MySQL (Aiven → Overview / Connection Information) ---
DB_HOST=mysql-biblioteca-eest5-xxxx.aivencloud.com
DB_PORT=27892
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb

# SSL: Aiven lo exige. Descargá el "CA certificate" de Aiven,
# guardalo como ca.pem en backend/ y dejá DB_CA_PATH=ca.pem
DB_SSL=true
DB_CA_PATH=ca.pem

# --- Sesión ---
# Cualquier texto largo y difícil de adivinar.
SESSION_SECRET=cambiar-por-una-clave-larga

# --- Servidor ---
PORT=3000

# --- PHP ---
# Cualquier texto largo y difícil de adivinar.
PHP_API_KEY=cambiar-por-una-clave-larga
